{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VisionLog Pro",
  "version": "0.1.0",
  "identifier": "com.visioncolor.visionlog",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "visionlog — DCP Look 移植",
        "width": 1000,
        "height": 720,
        "minWidth": 820,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon_32.png",
      "icons/icon_128.png",
      "icons/icon_256.png",
      "icons/icon_512.png"
    ],
    "resources": [
      "binaries/visionlog-engine*",
      "looks/*"
    ],
    "externalBin": []
  }
}